{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "SangDocCraft",
  "version": "1.0.0",
  "identifier": "com.sangdoccraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SangDocCraft - 智能 Markdown 排版工具",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragAndDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
